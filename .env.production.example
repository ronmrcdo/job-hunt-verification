# Production env for docker-compose.prod.yml. Copy to `.env.production`
# (gitignored) and fill in. Deploy with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Every var marked REQUIRED is enforced by compose (`${VAR:?...}`) — a missing
# one fails the `up` immediately instead of booting a half-configured stack.

# ── Hostnames (Traefik router rules) ─────────────────────────────────────────
# Also supplied to the `web` container as APP_ALLOWED_HOSTS — the auth
# callback route's redirect-host allow-list (apps/web/app/auth/callback/route.ts)
# must match this exactly, or it falls back to `origin`.
WEB_HOST=jobverifai.ronmrcdo.dev
# Serves only the Inngest dashboard now — job traffic (event sends, the
# /fn/register handshake, and callbacks into api-worker) stays on internal
# Docker DNS; see the Inngest section below.
INNGEST_HOST=jobverifai-inngest.ronmrcdo.dev
# The pre-existing external Docker network your Traefik instance attaches to.
TRAEFIK_NETWORK=traefik

# ── Image naming (optional) ──────────────────────────────────────────────────
# IMAGE_PREFIX=jobverifai
# IMAGE_TAG=latest

# ── Application database — REQUIRED ──────────────────────────────────────────
# The production Supabase project's Postgres (pooler/session URI).
DATABASE_URL=

# ── Secrets — REQUIRED ───────────────────────────────────────────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=

# ── Inngest — REQUIRED ───────────────────────────────────────────────────────
# Both keys are shared by the `inngest` server and the `api-worker` SDK; they
# must match exactly or every function call fails signature verification.
#
# The signing key must be PLAIN HEX with an even number of characters — the
# server length-checks the raw value before stripping any `signkey-...` prefix,
# so a prefixed key is rejected. Generate both with:
#   openssl rand -hex 32
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Password for Inngest's own Postgres (run state/history — NOT the app DB).
INNGEST_POSTGRES_PASSWORD=

# Internal Docker DNS on the shared coolify network — both directions of the
# api-worker <-> inngest hop stay off the public internet. Mirrors dev
# (docker-compose.yml: `inngest dev -u http://api-worker:8000/api/inngest`).
# NOTE: Coolify injects env set in its UI into containers, which can shadow
# these compose defaults — if a running container shows an unexpected value,
# check the Coolify UI's env settings for this service first.
#   INNGEST_BASE_URL     — worker -> Inngest: event sends and the
#                           /fn/register sync handshake.
#   INNGEST_SERVE_ORIGIN — the URL the SDK advertises during app sync; where
#                           Inngest calls back into the worker.
# Both are read by the SDK straight from env (inngest/_internal/config_lib.py).
INNGEST_BASE_URL=http://inngest:8288
INNGEST_SERVE_ORIGIN=http://api-worker:8000

# ── Database settings, applied once per environment ──────────────────────────
# NOT compose env vars — the emit trigger (AFTER INSERT via pg_net) reads these
# from Postgres settings, applied once per environment with:
#   alter database postgres set app.settings.inngest_base_url = 'http://inngest:8288';
#   alter database postgres set app.settings.inngest_event_key = '<INNGEST_EVENT_KEY>';
# Two settings, never one pre-joined URL, so key rotation touches one value.
#
# The hostname must resolve FROM INSIDE the Supabase Postgres container, which
# is a separate Coolify stack from this compose project. If `inngest` does not
# resolve there, use the public Inngest URL for inngest_base_url instead.

# Basic auth for the Inngest dashboard (it ships with NO authentication of its
# own). htpasswd line(s), comma-separated for multiple users. Generate with:
#   docker run --rm httpd:alpine htpasswd -nbB admin '<password>'
# Paste the output verbatim — do NOT double the `$` characters. Compose does
# not re-interpolate a value substituted from this file, so a bcrypt hash like
# admin:$2y$05$Xk... passes through unchanged. (Doubling them would make the
# hash wrong and every login fail.)
# The /e/ event-ingestion path is deliberately exempt from this auth — the DB
# trigger (pg_net) posts there with INNGEST_EVENT_KEY and sends no
# Authorization header.
INNGEST_BASICAUTH_USERS=

# ── Web / Supabase — REQUIRED ────────────────────────────────────────────────
# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time. Changing
# either one needs `up -d --build`, not just a restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile SITE key for the auth captcha (public — baked into the
# client bundle at build time). Create a Turnstile widget in the Cloudflare
# dashboard; use its SITE key here and its SECRET key as
# SUPABASE_AUTH_CAPTCHA_SECRET on the Supabase stack (config.toml [auth.captcha]).
# Both must be set or sign-in/sign-up will fail: GoTrue requires a token and
# the browser must produce one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Model routing (optional; compose has sane defaults) ──────────────────────
# CHEAP_MODEL=gpt-5.6-luna
# STRONG_MODEL=gpt-5.6-luna
# CHEAP_REASONING_EFFORT=low
# STRONG_REASONING_EFFORT=high
# OPENAI_BASE_URL=
# STRUCTURED_OUTPUT_METHOD=json_schema
# STRUCTURED_OUTPUT_STRICT=true
# COST_PRICES_JSON=
