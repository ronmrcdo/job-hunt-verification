# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection. Leave UNSET to run against an in-memory dev store
# (main.py falls back to it when DATABASE_URL is absent) — handy for local
# frontend work without a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# External services.
TAVILY_API_KEY=
OPENAI_API_KEY=

# Model routing. CHEAP_* handles high-volume/low-stakes nodes; STRONG_* the
# reasoning-heavy ones. Effort is one of: low | medium | high.
CHEAP_MODEL=gpt-5.6-luna
STRONG_MODEL=gpt-5.6-luna
CHEAP_REASONING_EFFORT=low
STRONG_REASONING_EFFORT=high

# Inngest (worker only). The client runs in DEV_SERVER mode (is_production=
# False), so no signing/event keys are needed. Point it at the self-hosted dev
# server; INNGEST_BASE_URL sets both the API and event origins. Defaults to
# http://127.0.0.1:8288 when unset (running on the host); docker-compose sets
# http://inngest:8288.
# INNGEST_BASE_URL=http://127.0.0.1:8288

# ── Optional ──────────────────────────────────────────────────────────────
# All values below default in config.py; uncomment only to override.

# Per-source fetch timeout (seconds).
# FETCH_TIMEOUT_S=10.0
# Reject submissions whose job_text exceeds this length (mirrors the DB CHECK).
# MAX_JOB_TEXT_CHARS=40000
# Per-branch wall-clock budget (seconds).
# BRANCH_TIMEOUT_S=25.0
# Whole-investigation deadline (seconds).
# TOTAL_DEADLINE_S=90.0
# 'queued' rows older than this are treated as stale and re-dispatched.
# STALE_QUEUED_THRESHOLD_S=900.0
# 'running' rows older than this (since creation) are swept as zombies.
# ZOMBIE_RUNNING_THRESHOLD_S=300.0

# Override per-1M-token USD pricing used by the cost tracker. JSON object keyed
# by a substring of the model id, e.g. {"luna":{"in":0.2,"cached":0.02,"out":1.2}}.
# COST_PRICES_JSON=
