# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection. Leave UNSET to run against an in-memory dev store
# (main.py falls back to it when DATABASE_URL is absent) — handy for local
# frontend work without a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# External services.
TAVILY_API_KEY=
OPENAI_API_KEY=

# Alternate OpenAI-compatible endpoint (local llama.cpp/Ollama in dev). Leave
# UNSET for the real api.openai.com. Against the compose `llama` service, use
# http://llama:8080/v1; running the worker on the host, http://localhost:8081/v1.
# OPENAI_BASE_URL=

# Model routing. CHEAP_* handles high-volume/low-stakes nodes; STRONG_* the
# reasoning-heavy ones. Effort is one of: low | medium | high (blank = omit it).
CHEAP_MODEL=gpt-5.6-luna
STRONG_MODEL=gpt-5.6-luna
CHEAP_REASONING_EFFORT=low
STRONG_REASONING_EFFORT=high

# How structured output is coerced. OpenAI-native default below. DeepSeek
# rejects json_schema, so switch to function_calling + strict=false there; the
# parse-retry in llm.py covers the weaker guarantee. Method is one of:
# json_schema | function_calling | json_mode.
STRUCTURED_OUTPUT_METHOD=json_schema
STRUCTURED_OUTPUT_STRICT=true

# --- DeepSeek (OpenAI-SDK compatible) swap -------------------------------
# Point at DeepSeek and use the v4 model IDs (deepseek-chat/-reasoner retired
# 2026-07-24). deepseek-v4-pro reasoning support for structured output is not
# guaranteed — spike the analysis node before trusting it.
#   OPENAI_API_KEY=<deepseek-key>
#   OPENAI_BASE_URL=https://api.deepseek.com
#   CHEAP_MODEL=deepseek-v4-flash
#   STRONG_MODEL=deepseek-v4-pro
#   CHEAP_REASONING_EFFORT=          # blank: flash rejects low/medium
#   STRONG_REASONING_EFFORT=high     # v4 takes high|max only
#   STRUCTURED_OUTPUT_METHOD=function_calling
#   STRUCTURED_OUTPUT_STRICT=false
#   COST_PRICES_JSON={"deepseek-v4-flash":{"in":0,"cached":0,"out":0},"deepseek-v4-pro":{"in":0,"cached":0,"out":0}}
# -------------------------------------------------------------------------

# Inngest (worker only). The client runs in DEV_SERVER mode (is_production=
# False), so no signing/event keys are needed. Point it at the self-hosted dev
# server; INNGEST_BASE_URL sets both the API and event origins. Defaults to
# http://127.0.0.1:8288 when unset (running on the host); docker-compose sets
# http://inngest:8288.
# INNGEST_BASE_URL=http://127.0.0.1:8288

# ── Optional ──────────────────────────────────────────────────────────────
# All values below default in config.py; uncomment only to override.

# Per-source fetch timeout (seconds).
# FETCH_TIMEOUT_S=10.0
# Reject submissions whose job_text exceeds this length (mirrors the DB CHECK).
# MAX_JOB_TEXT_CHARS=40000
# Per-branch wall-clock budget (seconds).
# BRANCH_TIMEOUT_S=25.0
# Whole-investigation deadline (seconds).
# TOTAL_DEADLINE_S=1200.0
# 'queued' rows older than this are treated as stale and re-dispatched.
# STALE_QUEUED_THRESHOLD_S=900.0
# 'running' rows older than this (since started) are swept as zombies.
# Keep comfortably above TOTAL_DEADLINE_S so a legit in-flight run is never swept.
# ZOMBIE_RUNNING_THRESHOLD_S=1800.0

# Override per-1M-token USD pricing used by the cost tracker. JSON object keyed
# by a substring of the model id, e.g. {"luna":{"in":0.2,"cached":0.02,"out":1.2}}.
# COST_PRICES_JSON=
