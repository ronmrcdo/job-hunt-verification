NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# Cloudflare Turnstile site key for the auth captcha. This default is
# Cloudflare's documented "always passes" TEST key, so local sign-in works
# without a real account. Pair it with the always-pass TEST secret key on the
# Supabase side: SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
# In production, set your real site key (see .env.production.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
