# Root env for docker-compose. Copy to `.env` (gitignored) and fill in.
# Prerequisite: `supabase start` is running (provides Postgres/Auth on :54321/:54322).

# ── Secrets (required for real runs) ─────────────────────────────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=

# ── Model routing (optional; compose has sane defaults) ──────────────────────
# CHEAP_MODEL=gpt-5.6-luna
# STRONG_MODEL=gpt-5.6-luna
# CHEAP_REASONING_EFFORT=low
# STRONG_REASONING_EFFORT=high

# ── Local LLM (optional; substitute the OpenAI API in dev) ────────────────────
# Point the OpenAI client at the `llama` compose service instead of OpenAI.
# Uncomment ALL of these, then `docker compose --profile llm up`.
# OPENAI_BASE_URL=http://llama:8080/v1
# CHEAP_MODEL=Qwen2.5-7B-Instruct-Q4_K_M
# STRONG_MODEL=Qwen2.5-7B-Instruct-Q4_K_M
# LLAMA_HF_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
# LLAMA_CTX=16384

# ── Web / Supabase ───────────────────────────────────────────────────────────
# Anon key is printed by `supabase start`. URL defaults to the CLI gateway.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Wire the AFTER INSERT trigger to the self-hosted Inngest ─────────────────
# The trigger POSTs directly to Inngest via pg_net, reading two database
# settings. Set them from inside the DB container:
#   alter database postgres set app.settings.inngest_base_url = 'http://host.docker.internal:8288';
#   alter database postgres set app.settings.inngest_event_key = 'local-dev';
# `host.docker.internal` is required (not `localhost`) because the URL must
# resolve from inside the Postgres container. See scripts/RUNBOOK.md §4a.
